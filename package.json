{
  "name": "@monosashi/ductloss-core",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "住宅の換気・ダクト空調の圧損計算（ダルシー・ワイスバッハ／ζ·q、風量の集計、送風機の合否判定、点検、機能の入／切）。設計係数は使う側が渡す。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lartdevie-studio/ductloss-core.git"
  },
  "homepage": "https://github.com/lartdevie-studio/ductloss-core#readme",
  "bugs": {
    "url": "https://github.com/lartdevie-studio/ductloss-core/issues"
  },
  "keywords": [
    "duct",
    "pressure loss",
    "ventilation",
    "HVAC",
    "ダクト",
    "圧損",
    "換気"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "SPEC.en.md",
    "AI_GUIDE.md",
    "VALIDATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/node": "^20.0.0"
  }
}
